# VyVy WorkOS V2 — biến môi trường
# Lấy từ Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Chỉ dùng phía server (KHÔNG để lộ ra client):
SUPABASE_SERVICE_ROLE_KEY=

# development | staging | production
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development
# Default blank. Only set locally if Quang explicitly accepts writing from localhost to production.
ALLOW_LOCAL_PROD_QA_WRITES=
